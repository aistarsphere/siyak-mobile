# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
# Figma Make design handoff — local reference only, not part of the app
design_reference/

# Secrets — never commit credentials / signing material
secret/
**/client_secret*.json
# NOTE: google-services.json / GoogleService-Info.plist are Firebase *client*
# config (not secrets — the API key is restricted by app signature/bundle).
# They are committed so the Firebase foundation is reproducible from a clean
# clone. Real secrets (OAuth client secrets, service accounts, keystores, .env)
# remain ignored above/below.
android/key.properties
**/*.keystore
**/*.jks
**/*.p8
**/*.p12
.env
.env.*

# QA artifacts — local reports & device screenshots, not part of the source tree
docs/qa/
UX_ISSUES_REPORT.md

# Screenshots / rendered images — kept local, not committed.
# NOTE: this also excludes the design-system golden baselines under
# test/design/goldens/. Golden *tests* still run, but with no committed baseline
# they only catch layout/paint exceptions, not visual regressions — and CI or a
# fresh clone must regenerate with:
#   flutter test --update-goldens
# Drop the `test/**/goldens/` line if you later want visual-regression coverage.
test/**/goldens/
**/*.png
**/*.jpg
**/*.jpeg
**/*.gif
**/*.webp
# Re-include shipped image assets only. Scoped to image extensions on purpose —
# a bare `!assets/**` would also un-ignore .DS_Store and friends.
!assets/**/*.png
!assets/**/*.jpg
!assets/**/*.webp
!android/app/src/main/res/**/*.png
!ios/Runner/Assets.xcassets/**/*.png
